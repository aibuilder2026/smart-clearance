 parent="1"><mxGeometry x="340" y="90" width="140" height="56" as="geometry"/></mxCell><mxCell id="agentsv8" value="&lt;b&gt;Vision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;Gemini Flash, multimodal&lt;br&gt;&lt;br&gt;asks for a label photo and reads what is printed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="140" height="200" as="geometry"/></mxCell><mxCell id="agentse9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#45554d;labelBackgroundColor=#ffffff;strokeColor=#167a52;strokeWidth=3;" edge="1" parent="1" source="agentsv4" target="agentsv7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agentsv10" value="&lt;b&gt;Value&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#e6f7f4;strokeColor=#0d9488;strokeWidth=2;fontColor=#0d1c15;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="140" height="56" as="geometry"/></mxCell><mxCell id="agentsv11" value="&lt;b&gt;Valuer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;Gemini Pro&lt;br&gt;&lt;br&gt;every exit priced by the money rules; a note on each&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="140" height="200" as="geometry"/></mxCell><mxCell id="agentse12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#45554d;labelBackgroundColor=#ffffff;strokeColor=#167a52;strokeWidth=3;" edge="1" parent="1" source="agentsv7" target="agentsv10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agentsv13" value="&lt;b&gt;Decide&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#e6f7f4;strokeColor=#0d9488;strokeWidth=2;fontColor=#0d1c15;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="140" height="56" as="geometry"/></mxCell><mxCell id="agentsv14" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;Gemini Pro&lt;br&gt;&lt;br&gt;the split across exits, explained in plain words&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="660" y="180" width="140" height="200" as="geometry"/></mxCell><mxCell id="agentse15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#45554d;labelBackgroundColor=#ffffff;strokeColor=#167a52;strokeWidth=3;" edge="1" parent="1" source="agentsv10" target="agentsv13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agentsv16" value="&lt;b&gt;Approve&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#fff3d4;strokeColor=#b07a06;strokeWidth=2;fontColor=#2a1c00;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="140" height="56" as="geometry"/></mxCell><mxCell id="agentsv17" value="&lt;b&gt;The approver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;a person&lt;br&gt;&lt;br&gt;one yes in the workspace app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="820" y="180" width="140" height="200" as="geometry"/></mxCell><mx