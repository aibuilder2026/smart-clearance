al&lt;br&gt;&lt;br&gt;papers drafted by the API, rendered as PDFs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1140" y="180" width="140" height="200" as="geometry"/></mxCell><mxCell id="agentse24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#45554d;labelBackgroundColor=#ffffff;strokeColor=#167a52;strokeWidth=3;" edge="1" parent="1" source="agentsv19" target="agentsv22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agentsv25" value="&lt;b&gt;Report&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#e6f7f4;strokeColor=#0d9488;strokeWidth=2;fontColor=#0d1c15;" vertex="1" parent="1"><mxGeometry x="1300" y="90" width="140" height="56" as="geometry"/></mxCell><mxCell id="agentsv26" value="&lt;b&gt;Impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;Gemini Flash, optional&lt;br&gt;&lt;br&gt;posts the ledger to the workspace and BigQuery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1300" y="180" width="140" height="200" as="geometry"/></mxCell><mxCell id="agentse27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#45554d;labelBackgroundColor=#ffffff;strokeColor=#167a52;strokeWidth=3;" edge="1" parent="1" source="agentsv22" target="agentsv25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agentst28" value="backend-api computes every figure; Gemini writes only words, checked against those figures before they are sent. The reserve price never reaches a prompt." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6e67;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cicd" name="CI/CD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cicdt1" value="CI/CD: GitHub Actions gates every change, Cloud Build ships it to Cloud Run" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#0d1c15;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="900" height="30" as="geometry"/></mxCell><mxCell id="cicdv2" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;to main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#a1aca6;fontColor=#0d1c15;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="cicdv3" value="&lt;b&gt;GitHub Actions · gates in parallel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#f8faf9;strokeColor=#cfd8d3;fontColor=#5f6e67;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="60" width="760" height="130" as="geometry"/></mxCell><mxCell id="cicdv4" value="&lt;b&gt;Frontend gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6e67&quot;&gt;lint, types, unit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#167a52;strokeWidth=2;fontColor=#0d1c15;" vertex="1" parent="1"><mxGeometry x="226" y="100"