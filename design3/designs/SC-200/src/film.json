 "vo": {
  "p1": {
   "at": 2.2,
   "dur": 2.814,
   "text": "Every day in India, good food runs out of time."
  },
  "p2": {
   "at": 5.614,
   "dur": 3.158,
   "text": "Not because it has spoiled, but because it is short-dated."
  },
  "p3": {
   "at": 9.272,
   "dur": 3.994,
   "text": "Once a batch slips past the quick-commerce cut-off, nobody will take it."
  },
  "p4": {
   "at": 13.766,
   "dur": 5.827,
   "text": "So it is written off, its tax credit is reversed, and perfectly good food ends up in a landfill."
  },
  "i1": {
   "at": 21.993,
   "dur": 3.643,
   "text": "Smart-Clearance gives every one of those cartons a second chance."
  },
  "i2": {
   "at": 26.336,
   "dur": 12.287,
   "text": "It is software as a service for manufacturers. Every brand gets its own workspace, where ten AI agents, built on Gemini, walk each short-dated batch to the exits that recover the most."
  },
  "i3": {
   "at": 39.123,
   "dur": 2.121,
   "text": "And a person says yes, just once."
  },
  "c1": {
   "at": 45.544,
   "dur": 4.406,
   "text": "It all begins in the console, where the Smart-Clearance team runs the platform."
  },
  "c2": {
   "at": 50.65,
   "dur": 7.237,
   "text": "One overview shows every client at a glance: what has been recovered, what is in flight, and what is waiting for a yes."
  },
  "c3": {
   "at": 58.587,
   "dur": 10.56,
   "text": "Each client's agents are tuned to its own supply chain: the Watcher's quick-commerce gates, how far the Negotiator may bargain, and the one approval that is never switched off."
  },
  "m1": {
   "at": 73.147,
   "dur": 3.241,
   "text": "Now, two batches from Munchly Foods, live in production."
  },
  "m2": {
   "at": 77.338,
   "dur": 10.304,
   "text": "First, the Mango Drink at Lakshmi Agencies in Hyderabad. The Watcher flags it: twenty-two days left, and over twenty-two thousand rupees about to be written off."
  },
  "m3": {
   "at": 88.492,
   "dur": 5.172,
   "text": "Vision reads the carton's label from a single photo, and matches it to the stock export."
  },
  "m4": {
   "at": 94.514,
   "dur": 7.455,
   "text": "The Valuer prices every exit, the Router splits the batch, and Priya, in supply chain, approves the plan with one yes."
  },
  "m5": {
   "at": 102.819,
   "dur": 6.61,
   "text": "Fifty-two kiranas take the scheme. Every order lands live on her screen, each with its own tax invoice."
  },
  "m6": {
   "at": 110.279,
   "dur": 7.987,
   "text": "The staff sale is checked against its U P I receipt, and Feeding India collects fifty-eight packs, with a donation receipt of its own."
  },
  "m7": {
   "at": 119.116,
   "dur": 10.547,
   "text": "Paperwork signs every paper, Impact posts the ledger, and Lakshmi Agencies ends whole. Nearly seventeen thousand rupees recovered, and nothing left to waste."
  },
  "k1": {
   "at": 134.113,
   "dur": 1.928,
   "text": "But not every batch goes to plan."
  },
  "k2": {
   "at": 136.991,
   "dur": 6.176,
   "text": "The Masala Chips at Rakesh Traders in Nagpur are offered to thirty-eight kiranas. Just two of them buy."
  },
  "k3": {
   "at": 144.017,
   "dur": 10.501,
   "text": "On Expire Soon, a wholesaler bids thirteen rupees a pack. The Negotiator counters at fourteen rupees twenty, and seven hundred and seventy-two packs are sold."
  },
  "k4": {
   "at": 155.368,
   "dur": 4.91,
   "text": "Still, when the window closes, five hundred and forty packets are left at the godown."
  },
  "k5": {
   "at": 161.228,
   "dur": 9.122,
   "text": "On expiry day, nothing is hidden. Rakesh sends two photos, before and after, and Vision checks the label, the count, the slate and the landfill."
  },
  "k6": {
   "at": 171.2,
   "dur": 6.013,
   "text": "The agency's officer, two witnesses and Rakesh sign the certificate in place, right on his screen."
  },
  "k7": {
   "at": 178.063,
   "dur": 11.315,
   "text": "Only after Priya's second yes is the credit note issued. Even now, nearly twelve thousand rupees are recovered, the distributor ends whole, and every kilo is on the record."
  },
  "f1": {
   "at": 192.828,
   "dur": 7.232,
   "text": "The brand recovers. The distributor ends whole. Kiranas earn, food banks receive, and less food goes to waste."
  },
  "f2": {
   "at": 200.86,
   "dur": 3.679,
   "text": "Smart-Clearance. Every near-expiry carton, a second chance."
  }
 },
