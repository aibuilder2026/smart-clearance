node_modules/
.venv/
video/out/
video/my-voice/
*.mp4
.DS_Store
.impeccable/
docs/story-img/*.png
video/clips/*.json
.playwright-mcp/

# design v2 plates: 1024 px PNG originals stay local; the 512 px WebPs ship
design2/system/img/*.png

# design v3: generated PNG originals (WebP ships)
design3/system/img/src/
design3/system/media/src/
# the v3 carton loop ships (small, H.264)
!design3/system/media/carton-loop.mp4

# design3 platform pages: generated PNG originals stay local (WebP ships)
design3/site/assets/plates/src/
# the landing page's film (SC-60) ships (small, H.264)
!design3/site/assets/media/*.mp4

# design reviews: PNG originals stay local, only WebP ships (SC-26)
design3/designs/*/src/
design3/designs/*/round-*/src/
# their motion previews and short clips ship (small, H.264), as the carton loop does
!design3/designs/*/option-*/motion.mp4
!design3/designs/*/round-*/option-*/motion.mp4
!design3/designs/*/media/*.mp4

# frontend (SC-27): build output, test reports and local env files
frontend/**/.svelte-kit/
frontend/**/build/
frontend/**/test-results/
frontend/**/playwright-report/
frontend/**/playwright-report-live/
frontend/**/blob-report/
frontend/**/playwright-report-journey/
# Munchly Chips E2E runs (SC-95): the report and its stills ship; the recordings stay local
frontend/workspace/tests/journey/runs/**/*.webm
frontend/**/tests/parity/out/
frontend/**/.env
frontend/**/.env.*
# Firebase CLI's deploy cache
frontend/.firebase/
!frontend/**/.env.example
*.tsbuildinfo

# the Python services (backend-api, agents)
__pycache__/
.pytest_cache/
.ruff_cache/
# backend-api (SC-45): local overrides only; every secret lives in Secret Manager, never in a file
backend-api/.env
backend-api/.env.*
!backend-api/.env.example

# infra (SC-39): Terraform's working files. State lives in the GCS bucket; .terraform.lock.hcl is committed
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/*.plan.txt
infra/**/backend_override.tf
infra/**/crash.log
# written by infra/scripts/deploy.sh from Terraform's outputs
frontend/.firebaserc
.claude/settings.local.json
design3/system/labels/src/
design3/system/signatures/src/
design3/system/receipts/src/

