{
	"name": "@smart-clearance/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./site": {
			"types": "./src/site.ts",
			"default": "./src/site.ts"
		},
		"./console": {
			"types": "./src/console/index.ts",
			"default": "./src/console/index.ts"
		},
		"./workspace": {
			"types": "./src/workspace/index.ts",
			"default": "./src/workspace/index.ts"
		},
		"./seed/*": "./src/seed/*",
		"./firebase": {
			"types": "./src/firebase.ts",
			"default": "./src/firebase.ts"
		}
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@smart-clearance/core": "workspace:*",
		"firebase": "12.19.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
