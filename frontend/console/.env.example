# Copy to .env (never committed). Every variable is optional; see src/env.ts.
# PUBLIC_API_BASE=http://localhost:8000
# PUBLIC_MOCK_LATENCY_MS=400
# PUBLIC_SITE_URL=
# PUBLIC_APP_URL=
# To sign in against a local backend-api with Firebase Authentication, run backend-api/scripts/console-env.sh, which
# writes .env.local with PUBLIC_API_BASE and these, from Terraform's console_firebase_config output:
# PUBLIC_FIREBASE_API_KEY=
# PUBLIC_FIREBASE_AUTH_DOMAIN=
# PUBLIC_FIREBASE_PROJECT_ID=
# PUBLIC_FIREBASE_APP_ID=
