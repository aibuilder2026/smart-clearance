exports[`the parts a tap opens > every document of the pack 1`] = `
{
  "destruction": "Destruction certificate MF-2409-117 NOT REQUIREDUnits left to destroy0 Issued only when units remain, with the ITC reversal entry pre-filled so finance is never surprised.",
  "eway": "E-way bill check MF-2409-117 · ES-24117 NOT REQUIREDConsignment value with GST₹11,510.00Threshold, inter-state₹50,000.00E-way billnot required The consignment is ₹11,510 with GST, under the ₹50,000 threshold. Checked again if the dispatch is split. A transporter note travels with the 32 cartons + 4 on the buyer's truck instead.",
  "fssai": "FSSAI surplus-food checklist MF-2409-117 NOT REQUIRED Nothing from this batch was donated. The Mango Drink batch MF-2410-118 has its own checklist: 58 packs to Feeding India, Hyderabad.",
  "invoice": "Tax invoice INV/26-27/0931 · draft · 5 Oct 2026 IGST FromRakesh TradersKalamna Market, Nagpur, MaharashtraGSTIN 27AABCR1234F1Z5 ToAgrawal WholesaleGanj Mandi, Raipur, Chhattisgarh · place of supply 22GSTIN 22AAGFA4821M1Z3 ItemHSNQtyRateTaxableMunchly Masala Chips 150 gBatch MF-2409-117 · best before 18 Nov 20262005772₹14.20₹10,962.40 Taxable value₹10,962.40IGST 5% Maharashtra → Chhattisgarh₹548.00Round off−₹0.40Invoice total₹11,510.00 Drafted by the Paperwork agent for Rakesh Traders to issue from Tally. Chips moved from 12% to 5% GST under GST 2.0 on 22 September 2025. The MRP of ₹30.00 stays printed on every pack: a discounted sale is fine, a second MRP is not (Legal Metrology).",
  "itc": "GST ITC memo Section 17(5)(h) · Munchly Foods ITC KEPTPackets sold under tax invoices1,360Destroyed, gifted or lost0Input GST on the stock ₹0.90 a pack, from the cost sheet₹1,224.00Reversal in GSTR-3B, Table 4(B)(1)none Section 17(5)(h) blocks credit on goods written off, destroyed, lost or given away free. These packs were sold under tax invoices, so it does not apply. The credit would be reversed only if the stock came back under the expiry claim and Munchly destroyed it. Credit on donated units is reversed: 17(5)(h) blocks it on gifts and, since 1 October 2023, 17(5)(fa) on CSR donations.",
  "support": "Price-support credit note CN/0117 · Munchly Foods → Rakesh Traders NO GST ADJ. 772 sold on ExpireSoon at ₹14.20 ₹22 − ₹14.20 = ₹7.80 a pack₹6,021.60 588 sold to 31 kiranas at ₹18 effective ₹22 − ₹18 = ₹4.00, free packs included₹2,352.00 Van delivery 588 × ₹0.50₹294.00ExpireSoon listing fee₹100.00Round off₹0.40 Credit to Rakesh Traders₹8,768.00 A financial credit note, with no GST adjustment, so Rakesh Traders ends whole at the ₹22 it paid. It covers the buy-10-get-2 scheme too, so no separate scheme note is needed. Munchly pays this instead of an expiry claim of ₹34,490. Trued up after the return window closes on 29 Oct.",
}
`;

