{
	"name": "@smart-clearance/demo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"test:a11y": "vite build && playwright test --project=desktop-light --project=desktop-dark --project=tablet-light --project=phone-light --project=phone-dark && node ../testing/src/a11y-coverage.ts",
		"test:e2e": "vite build && playwright test --project=flows --project=firefox-desktop --project=webkit-tablet --project=webkit-phone",
		"test:parity": "vite build && playwright test -c playwright.parity.config.ts"
	},
	"dependencies": {
		"@smart-clearance/core": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@smart-clearance/testing": "workspace:*",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "catalog:",
		"@types/pngjs": "^6.0.5",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"a11yCoverage": {
		"why": "The demo's people are the story's: the workspace admin is never one of them and switching person is off, so the admin's screens, and the workspace app's own shell, are never on the demo's screen (SC-65). On Neha's laptop the console shows its sign-in, Overview, Clients, New client and a client's Agents, Supply chain, Channels & rules and People tabs (SC-167); its Connectors, Plans, Staff and Audit log pages, the account sheet, the client's actions menu and its Integrations and Plan tabs, and the sheets opened from a tab (an SKU's gates, the profile, the journey day, Reset journey) are never visited.",
		"unreached": [
			"workspace/WorkspaceApp.svelte",
			"workspace/screens/admin/WorkspaceSettings.svelte",
			"workspace/screens/admin/Users.svelte",
			"workspace/screens/admin/RowMenu.svelte",
			"workspace/screens/admin/Rules.svelte",
			"workspace/screens/admin/Integrations.svelte",
			"workspace/screens/admin/Audit.svelte",
			"console/screens/Connectors.svelte",
			"console/screens/Plans.svelte",
			"console/screens/PlanScope.svelte",
			"console/screens/Staff.svelte",
			"console/screens/Audit.svelte",
			"console/screens/AuditList.svelte",
			"console/screens/AccountSheet.svelte",
			"console/screens/Failed.svelte",
			"console/screens/MoreMenu.svelte",
			"console/screens/client/IntegrationsTab.svelte",
			"console/screens/client/PlanTab.svelte",
			"console/screens/client/ResetJourneySheet.svelte",
			"console/screens/client/JourneyDaySheet.svelte",
			"console/screens/client/ProfileSheet.svelte",
			"console/screens/client/SkuSheet.svelte"
		]
	}
}
