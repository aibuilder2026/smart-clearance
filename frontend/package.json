{
	"name": "smart-clearance-frontend",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "corepack pnpm --filter @smart-clearance/admin dev",
		"dev:console": "corepack pnpm --filter @smart-clearance/console dev",
		"dev:workspace": "corepack pnpm --filter @smart-clearance/workspace dev",
		"dev:demo": "corepack pnpm --filter @smart-clearance/demo dev",
		"build": "corepack pnpm --filter @smart-clearance/admin --filter @smart-clearance/console --filter @smart-clearance/workspace --filter @smart-clearance/demo run build",
		"build:admin": "corepack pnpm --filter @smart-clearance/admin build",
		"build:console": "corepack pnpm --filter @smart-clearance/console build",
		"build:workspace": "corepack pnpm --filter @smart-clearance/workspace build",
		"build:demo": "corepack pnpm --filter @smart-clearance/demo build",
		"preview": "corepack pnpm --filter @smart-clearance/admin preview",
		"preview:console": "corepack pnpm --filter @smart-clearance/console preview",
		"preview:workspace": "corepack pnpm --filter @smart-clearance/workspace preview",
		"preview:demo": "corepack pnpm --filter @smart-clearance/demo preview",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check": "corepack pnpm -r --sequential run check",
		"test": "corepack pnpm seed:check && corepack pnpm icons:check && corepack pnpm -r --sequential run test",
		"test:a11y": "corepack pnpm test:a11y:admin && corepack pnpm test:a11y:console && corepack pnpm test:a11y:workspace && corepack pnpm test:a11y:demo",
		"test:a11y:admin": "corepack pnpm --filter @smart-clearance/admin test:a11y",
		"test:a11y:console": "corepack pnpm --filter @smart-clearance/console test:a11y",
		"test:a11y:workspace": "corepack pnpm --filter @smart-clearance/workspace test:a11y",
		"test:a11y:demo": "corepack pnpm --filter @smart-clearance/demo test:a11y",
		"test:e2e": "corepack pnpm test:e2e:admin && corepack pnpm test:e2e:console && corepack pnpm test:e2e:workspace && corepack pnpm test:e2e:demo",
		"test:e2e:admin": "corepack pnpm --filter @smart-clearance/admin test:e2e",
		"test:e2e:console": "corepack pnpm --filter @smart-clearance/console test:e2e",
		"test:e2e:workspace": "corepack pnpm --filter @smart-clearance/workspace test:e2e",
		"test:e2e:demo": "corepack pnpm --filter @smart-clearance/demo test:e2e",
		"test:parity": "corepack pnpm test:parity:admin && corepack pnpm test:parity:console && corepack pnpm test:parity:workspace && corepack pnpm test:parity:demo",
		"test:parity:admin": "corepack pnpm --filter @smart-clearance/admin test:parity",
		"test:parity:console": "corepack pnpm --filter @smart-clearance/console test:parity",
		"test:parity:workspace": "corepack pnpm --filter @smart-clearance/workspace test:parity",
		"test:parity:demo": "corepack pnpm --filter @smart-clearance/demo test:parity",
		"seed": "node scripts/seed.mjs",
		"seed:check": "node scripts/seed.mjs --check",
		"icons": "node scripts/icons.mjs",
		"icons:check": "node scripts/icons.mjs --check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.0"
	}
}
