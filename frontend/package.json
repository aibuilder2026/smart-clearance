{
	"name": "smart-clearance-frontend",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "corepack pnpm --filter @smart-clearance/admin dev",
		"build": "corepack pnpm --filter @smart-clearance/admin build",
		"preview": "corepack pnpm --filter @smart-clearance/admin preview",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check": "corepack pnpm -r --sequential run check",
		"test": "corepack pnpm seed:check && corepack pnpm icons:check && corepack pnpm -r --sequential run test",
		"test:e2e": "corepack pnpm --filter @smart-clearance/admin test:e2e",
		"test:parity": "corepack pnpm --filter @smart-clearance/admin test:parity",
		"seed": "node scripts/seed.mjs",
		"seed:check": "node scripts/seed.mjs --check",
		"icons": "node scripts/icons.mjs",
		"icons:check": "node scripts/icons.mjs --check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.0"
	}
}
