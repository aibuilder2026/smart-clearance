		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "catalog:",
		"@types/node": "catalog:",
		"@types/pngjs": "^6.0.5",
		"jsdom": "catalog:",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
