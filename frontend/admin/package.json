		"test:parity": "PUBLIC_DEV_ROUTES=1 vite build && playwright test -c playwright.parity.config.ts"
	},
	"dependencies": {
		"@smart-clearance/core": "workspace:*",
		"@tanstack/svelte-query": "^6.3.1",
		"motion": "catalog:"
	},
