# Copy to .env (never committed). Every variable is optional; see src/env.ts. Unset, the workspace runs on its stub.
# To run on a local backend-api, run backend-api/scripts/app-env.sh, which writes .env.local with these, from
# Terraform's workspace_firebase_config output:
# PUBLIC_API_BASE=http://localhost:8000
# PUBLIC_WORKSPACE_ID=munchly
# PUBLIC_FIREBASE_API_KEY=
# PUBLIC_FIREBASE_AUTH_DOMAIN=
# PUBLIC_FIREBASE_PROJECT_ID=
# PUBLIC_FIREBASE_APP_ID=
# PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
