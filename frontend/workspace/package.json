{
	"name": "@smart-clearance/workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"test:a11y": "vite build && playwright test --project=desktop-light --project=desktop-dark --project=tablet-light --project=phone-light --project=phone-dark && node ../testing/src/a11y-coverage.ts",
		"test:e2e": "vite build && playwright test --project=flows --project=firefox-desktop --project=webkit-tablet --project=webkit-phone",
		"test:parity": "vite build && playwright test -c playwright.parity.config.ts",
		"test:journey": "playwright test -c playwright.journey.config.ts --project=\"Munchly Chips E2E\"",
		"test:journey:mango": "playwright test -c playwright.journey.config.ts --project=\"Munchly Mango E2E\""
	},
	"dependencies": {
		"@smart-clearance/api": "workspace:*",
		"@smart-clearance/core": "workspace:*",
		"firebase": "12.19.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@smart-clearance/testing": "workspace:*",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "catalog:",
		"@types/node": "catalog:",
		"@types/pngjs": "^6.0.5",
		"jsdom": "catalog:",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
