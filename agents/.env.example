# agents/.env (git-ignored): what a laptop's agents run with besides what scripts/lib.sh sets (the project, the
# local buckets, dataset and subscriptions, sc-agents-local). No secrets: the agents use Google credentials only.

# The models on Vertex AI (README, "Models"). There is no default in code: name the ones to call. Listed with the
# project's credentials on 7 Oct 2026 (publishers/google/models): gemini-3.1-pro-preview (public preview) and
# gemini-3.8-flash (GA; 3.6 and 3.7 Flash are GA too).
MODEL_PRO=gemini-3.1-pro-preview
MODEL_FLASH=gemini-3.8-flash
# where the models are served: the Gemini 3 models are on the global endpoint
GENAI_LOCATION=global
# live calls Gemini; stub replays src/sc_agents/recordings/ (no model reached)
MODEL_TIER=live

# backend-api (backend-api/scripts/dev.sh)
API_BASE=http://localhost:8000

# optional
# IMPACT_NARRATIVE=true      # the Impact agent's BRSR narrative, one Flash call a cleared batch (logged, not sent)
# TRACE_EXPORT=otlp          # spans to Cloud Trace as sc-agents-local
# LOG_FORMAT=json
