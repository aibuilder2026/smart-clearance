# backend-api's settings (src/sc_api/settings.py). The scripts set these for you; copy to .env only to override.
# Never put a secret here: a secret is named by its Secret Manager reference and read at runtime.
SC_ENV=local
GOOGLE_CLOUD_PROJECT=aibuilder-510213
SC_IMPERSONATE_SA=sc-api-local@aibuilder-510213.iam.gserviceaccount.com
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_clearance
DB_USER=sc_api
DB_PASSWORD_SECRET=projects/aibuilder-510213/secrets/sc-local-db-app-password
DEFAULT_PASSWORD_SECRET=projects/aibuilder-510213/secrets/sc-default-user-password
STAFF_EMAIL_DOMAIN=smartclearance.example
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
