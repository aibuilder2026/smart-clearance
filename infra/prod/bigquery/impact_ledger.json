  { "name": "batch_ref", "type": "STRING", "mode": "REQUIRED", "description": "The cleared batch." },
  { "name": "sku_id", "type": "STRING", "mode": "REQUIRED", "description": "The client's SKU id." },
  { "name": "channel", "type": "STRING", "mode": "REQUIRED", "description": "The exit this line went through." },
  { "name": "units", "type": "INT64", "mode": "REQUIRED", "description": "Packs through the exit." },
  { "name": "kg", "type": "NUMERIC", "mode": "NULLABLE", "description": "Their weight diverted from landfill." },
  { "name": "co2e_kg", "type": "NUMERIC", "mode": "NULLABLE", "description": "CO2e avoided, indicative." },
  { "name": "meals", "type": "INT64", "mode": "NULLABLE", "description": "Meals, for a food-bank exit." },
  { "name": "recovered_inr", "type": "NUMERIC", "mode": "NULLABLE", "description": "Rupees recovered through the exit." },
